{
  "extends": "@proofbridge/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", "e2e", ".next/types/**/*.ts", "*.ts", "*.mjs"],
  "exclude": ["node_modules"]
}
