{
  "name": "proofbridge",
  "private": true,
  "description": "ProofBridge OS — local-first evidence → opportunity pipeline (monorepo root)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @proofbridge/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
